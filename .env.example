# Copy to .env and adjust. All keys map to api/config.py:Settings.
DATABASE_URL=postgresql://arnab@localhost:5432/tbx_finance

LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m

# Switch at the bake-off; interface is identical.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Phase 8. Ship off; turn on once the index is built and proven.
ENABLE_SEMANTIC=false

AMBIGUITY_SILENT=0.01
AMBIGUITY_DISCLOSE=0.10
