# Copy to .env and adjust. All keys map to api/config.py:Settings.

# DATASET and DATABASE_URL must agree - the profile supplies the column maps,
# the URL supplies the rows.
#   bank_txn         organizers' schema  -> tbx_live   (MySQL)
#   vendor_payments  the stand-in        -> tbx_finance (PostgreSQL only,
#                                           not ported - see MYSQL_PORT.md)
DATASET=bank_txn

# MySQL in Docker: docker start tbx-mysql
DATABASE_URL=mysql://tbx:tbx@127.0.0.1:3306/tbx_live

LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=30m

# Models the /ops canary can be run against, in picker order. Each must be
# pulled first; an unpulled name is refused before the run rather than scoring
# a meaningless 0%. Leave unset and only OLLAMA_MODEL is offered.
EVAL_MODELS=qwen2.5:7b-instruct,gemma3:4b-it-qat

# Switch at the bake-off; interface is identical.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Phase 8. Ship off; turn on once the index is built and proven.
ENABLE_SEMANTIC=false

AMBIGUITY_SILENT=0.01
AMBIGUITY_DISCLOSE=0.10

# ---------------------------------------------------------------------------
# Sensitive fields
#
# HMAC key for tokenizing account_number (api/crypto.py). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never committed, never in the database. Production would use KMS/Vault.
# ---------------------------------------------------------------------------
SENSITIVE_KEY=replace-me-generate-with-secrets.token_hex-32
